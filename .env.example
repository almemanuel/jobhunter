# Copie este arquivo para .env e preencha com suas credenciais locais.
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

RAPIDAPI_KEY=
GEMINI_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: habilita/desabilita coleta complementar na API pública da Gupy (padrão: false)
ENABLE_GUPY=false

# Recomendado: Neon PostgreSQL para deduplicação em 4 camadas e histórico de vagas
DATABASE_URL=
